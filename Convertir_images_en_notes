Sub Convertir_images_en_notes_Final_V3()
    Dim ws As Worksheet
    Dim shp As Shape
    Dim rngOrigine As Range, cell As Range
    Dim exclu As Variant, motCle As Variant
    Dim altText As String, tempPath As String
    Dim chtObj As ChartObject
    Dim i As Long
    Dim ratioImg As Double, cibleLargeur As Double, largeurOriginale As Double
    Dim t As Double

    ' Calcul du seuil (1/3 de la fenêtre Excel)
    cibleLargeur = ActiveWindow.UsableWidth / 3
    exclu = Array("skip", "noresize", "logo", "icone", "fixe")

    Set ws = ActiveSheet
    tempPath = Environ("TEMP") & "\temp_note_img.jpg"

    Application.ScreenUpdating = False

    For i = ws.Shapes.Count To 1 Step -1
        Set shp = ws.Shapes(i)
        
        If shp.Type = msoPicture Or shp.Type = msoLinkedPicture Then
            
            altText = ""
            On Error Resume Next: altText = shp.AlternativeText: On Error GoTo 0
            
            Dim skip As Boolean: skip = False
            For Each motCle In exclu
                If InStr(1, LCase(altText), LCase(motCle)) > 0 Then skip = True: Exit For
            Next

            If Not skip Then
                Set rngOrigine = shp.TopLeftCell
                Set cell = IIf(rngOrigine.MergeCells, rngOrigine.MergeArea, rngOrigine)
                
                ' Mémoriser la largeur actuelle de l'image avant export
                largeurOriginale = shp.Width
                ratioImg = shp.Height / shp.Width

                ' --- Exportation avec Pause de Sécurité ---
                shp.CopyPicture Appearance:=xlScreen, Format:=xlPicture
                
                Set chtObj = ws.ChartObjects.Add(0, 0, shp.Width, shp.Height)
                With chtObj
                    .Border.LineStyle = xlNone
                    .Activate
                    .Chart.Paste
                    
                    ' Pause forcée de 0.8 seconde pour garantir le rendu des pixels
                    t = Timer
                    Do While Timer < t + 0.8
                        DoEvents
                    Loop
                    
                    .Chart.Export Filename:=tempPath, FilterName:="JPG"
                    .Delete
                End With

                ' --- Création de la Note ---
                If Not cell.Comment Is Nothing Then cell.Comment.Delete
                cell.AddComment Text:=""
                
                With cell.Comment.Shape
                    .Fill.UserPicture tempPath
                    .LockAspectRatio = msoTrue
                    
                    ' CONDITION : Utilise 1/3 de l'écran SEULEMENT si l'image est plus grande
                    If largeurOriginale > cibleLargeur Then
                        .Width = cibleLargeur
                    Else
                        .Width = largeurOriginale
                    End If
                End With
                
                ' Nettoyage
                shp.Delete
                If Dir(tempPath) <> "" Then Kill tempPath
            End If
        End If
    Next i

    Application.ScreenUpdating = True
    MsgBox "Traitement terminé !", vbInformation
End Sub
