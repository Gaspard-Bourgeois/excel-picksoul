Sub Convertir_images_en_notes()
    Dim ws As Worksheet
    Dim shp As Shape
    Dim cell As Range
    Dim exclu As Variant, motCle As Variant
    Dim altText As String, tempPath As String
    Dim chtObj As ChartObject
    Dim i As Long
    Dim cibleLargeur As Double, cibleHauteur As Double
    Dim ratioImg As Double
    Dim t As Double

    ' Largeur : 1/3 de la fenêtre Excel
    cibleLargeur = ActiveWindow.UsableWidth / 3
    exclu = Array("skip", "noresize", "logo", "icone", "fixe")

    Set ws = ActiveSheet
    tempPath = Environ("TEMP") & "\temp_note_img.jpg"

    Application.ScreenUpdating = False

    For i = ws.Shapes.Count To 1 Step -1
        Set shp = ws.Shapes(i)
        
        If shp.Type = msoPicture Or shp.Type = msoLinkedPicture Then
            
            ' Vérification des mots-clés
            altText = ""
            On Error Resume Next: altText = shp.AlternativeText: On Error GoTo 0
            
            Dim skip As Boolean: skip = False
            For Each motCle In exclu
                If InStr(1, LCase(altText), LCase(motCle)) > 0 Then skip = True: Exit For
            Next

            If Not skip Then
                Set cell = shp.TopLeftCell.MergeArea
                
                ' --- RÉCUPÉRATION DU VRAI RATIO ---
                ' Remettre l'image à 100% pour capturer ses proportions d'origine
                On Error Resume Next
                shp.ScaleHeight 1, msoTrue
                shp.ScaleWidth 1, msoTrue
                On Error GoTo 0
                
                ' Calcul du ratio (Hauteur / Largeur)
                ratioImg = shp.Height / shp.Width
                
                ' Calcul de la hauteur cible pour forcer le commentaire
                cibleHauteur = cibleLargeur * ratioImg
                
                ' Exportation
                shp.CopyPicture Appearance:=xlScreen, Format:=xlPicture
                Set chtObj = ws.ChartObjects.Add(0, 0, shp.Width, shp.Height)
                With chtObj
                    .Border.LineStyle = xlNone
                    .Activate
                    .Chart.Paste
                    ' Enlever les bordures internes du graphique pour éviter les marges blanches
                    .Chart.ChartArea.Format.Line.Visible = msoFalse
                    
                    ' Pause pour le rendu du presse-papier
                    t = Timer: Do While Timer < t + 0.5: DoEvents: Loop
                    
                    .Chart.Export Filename:=tempPath, FilterName:="JPG"
                    .Delete
                End With

                ' Création de la Note
                If Not cell.Comment Is Nothing Then cell.Comment.Delete
                cell.AddComment Text:=""
                
                With cell.Comment.Shape
                    .Fill.UserPicture tempPath
                    
                    ' --- CORRECTION DU PROBLÈME DE RATIO ICI ---
                    .LockAspectRatio = msoFalse ' 1. On déverrouille
                    .Width = cibleLargeur       ' 2. On applique la largeur
                    .Height = cibleHauteur      ' 3. On FORCE la hauteur calculée
                    .LockAspectRatio = msoTrue  ' 4. On reverrouille au bon format
                End With
                
                ' Nettoyage
                shp.Delete
                If Dir(tempPath) <> "" Then Kill tempPath
            End If
        End If
    Next i

    Application.ScreenUpdating = True
End Sub
