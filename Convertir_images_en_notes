Sub Convertir_images_en_notes()
    Dim ws As Worksheet
    Dim shp As Shape
    Dim cell As Range
    Dim exclu As Variant, motCle As Variant
    Dim altText As String, tempPath As String
    Dim chtObj As ChartObject
    Dim i As Long
    Dim maxW As Double, maxH As Double
    Dim finalW As Double, finalH As Double
    Dim ratioImg As Double
    Dim t As Double

    ' Définition des seuils (2/3 de la fenêtre Excel)
    maxW = ActiveWindow.UsableWidth * (2 / 3)
    maxH = ActiveWindow.UsableHeight * (2 / 3)
    
    exclu = Array("skip", "noresize", "logo", "icone", "fixe")

    Set ws = ActiveSheet
    tempPath = Environ("TEMP") & "\temp_note_img.jpg"

    Application.ScreenUpdating = False

    For i = ws.Shapes.Count To 1 Step -1
        Set shp = ws.Shapes(i)
        
        If shp.Type = msoPicture Or shp.Type = msoLinkedPicture Then
            
            ' Vérification des mots-clés
            altText = ""
            On Error Resume Next: altText = shp.AlternativeText: On Error GoTo 0
            
            Dim skip As Boolean: skip = False
            For Each motCle In exclu
                If InStr(1, LCase(altText), LCase(motCle)) > 0 Then skip = True: Exit For
            Next

            If Not skip Then
                Set cell = shp.TopLeftCell.MergeArea
                
                ' Réinitialisation pour obtenir les dimensions réelles d'origine
                On Error Resume Next
                shp.ScaleHeight 1, msoTrue
                shp.ScaleWidth 1, msoTrue
                On Error GoTo 0
                
                ratioImg = shp.Height / shp.Width
                
                ' --- LOGIQUE DE REDIMENSIONNEMENT INTELLIGENT ---
                ' Par défaut, on prend la taille d'origine
                finalW = shp.Width
                finalH = shp.Height
                
                ' Si l'image est trop large, on réduit
                If finalW > maxW Then
                    finalW = maxW
                    finalH = finalW * ratioImg
                End If
                
                ' Si après réduction (ou d'origine) elle est encore trop haute, on réduit
                If finalH > maxH Then
                    finalH = maxH
                    finalW = finalH / ratioImg
                End If
                ' ------------------------------------------------
                
                ' Exportation via Graphique (aux dimensions d'origine pour la qualité)
                shp.CopyPicture Appearance:=xlScreen, Format:=xlPicture
                Set chtObj = ws.ChartObjects.Add(0, 0, shp.Width, shp.Height)
                With chtObj
                    .Border.LineStyle = xlNone
                    .Activate
                    .Chart.Paste
                    .Chart.ChartArea.Format.Line.Visible = msoFalse
                    
                    t = Timer: Do While Timer < t + 0.3: DoEvents: Loop
                    
                    .Chart.Export Filename:=tempPath, FilterName:="JPG"
                    .Delete
                End With

                ' Création de la Note
                If Not cell.Comment Is Nothing Then cell.Comment.Delete
                cell.AddComment Text:=""
                
                With cell.Comment.Shape
                    .Fill.UserPicture tempPath
                    .LockAspectRatio = msoFalse
                    .Width = finalW    ' Applique la largeur calculée (réduite ou d'origine)
                    .Height = finalH   ' Applique la hauteur calculée (réduite ou d'origine)
                    .LockAspectRatio = msoTrue
                End With
                
                ' Nettoyage
                shp.Delete
                If Dir(tempPath) <> "" Then Kill tempPath
            End If
        End If
    Next i

    Application.ScreenUpdating = True
End Sub
