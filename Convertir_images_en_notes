Sub Convertir_images_en_notes_V2()
    Dim ws As Worksheet
    Dim shp As Shape
    Dim rngOrigine As Range
    Dim cell As Range
    Dim exclu As Variant
    Dim skipImage As Boolean
    Dim motCle As Variant
    Dim altText As String
    Dim tempPath As String
    Dim chtObj As ChartObject
    Dim maNote As Comment
    Dim i As Long
    Dim ratioImg As Double
    Dim cibleLargeur As Double

    ' 1. Calcul de la largeur cible (1/3 de la zone d'affichage d'Excel)
    cibleLargeur = ActiveWindow.UsableWidth / 3

    exclu = Array("skip", "noresize", "logo", "icone", "fixe")

    Set ws = ActiveSheet
    Application.ScreenUpdating = False

    tempPath = Environ("TEMP") & "\temp_img.jpg"

    For i = ws.Shapes.Count To 1 Step -1
        Set shp = ws.Shapes(i)
        
        If shp.Type = msoPicture Or shp.Type = msoLinkedPicture Then
            
            altText = ""
            On Error Resume Next
            altText = shp.AlternativeText
            On Error GoTo 0
            
            skipImage = False
            For Each motCle In exclu
                If InStr(1, LCase(altText), LCase(motCle)) > 0 Then
                    skipImage = True
                    Exit For
                End If
            Next motCle

            If Not skipImage Then
                Set rngOrigine = shp.TopLeftCell
                Set cell = IIf(rngOrigine.MergeCells, rngOrigine.MergeArea, rngOrigine)
                
                ' Calcul du ratio de l'image d'origine
                ratioImg = shp.Height / shp.Width

                ' --- Exportation Fiabilisée ---
                shp.CopyPicture Appearance:=xlScreen, Format:=xlPicture
                
                ' Création d'un graphique temporaire aux dimensions de l'image
                Set chtObj = ws.ChartObjects.Add(0, 0, shp.Width, shp.Height)
                With chtObj
                    .Border.LineStyle = xlNone
                    .Chart.Paste
                    
                    ' Petite pause pour éviter le fond blanc (laisse le temps au collage de finir)
                    DoEvents
                    
                    .Chart.Export Filename:=tempPath, FilterName:="JPG"
                    .Delete
                End With
                ' ------------------------------

                ' Création de la Note
                If Not cell.Comment Is Nothing Then cell.Comment.Delete
                Set maNote = cell.AddComment(Text:="")
                
                With maNote.Shape
                    ' Verrouillage du ratio
                    .LockAspectRatio = msoTrue
                    
                    ' Appliquer l'image en fond
                    .Fill.UserPicture tempPath
                    
                    ' Redimensionner à 1/3 de l'écran
                    .Width = cibleLargeur
                    ' La hauteur s'ajuste seule si LockAspectRatio fonctionne, 
                    ' mais on assure le coup :
                    .Height = cibleLargeur * ratioImg
                End With
                
                ' Nettoyage
                shp.Delete
                If Dir(tempPath) <> "" Then Kill tempPath
            End If
        End If
    Next i

    Application.ScreenUpdating = True
    MsgBox "Conversion terminée !", vbInformation
End Sub
