Sub Sortir_image_de_la_note()
    Dim ws As Worksheet
    Dim cmt As Comment
    Dim shp As Shape
    Dim cell As Range
    Dim ratioImg As Double
    Dim cellWidth As Double, cellHeight As Double
    Dim newWidth As Double, newHeight As Double
    Dim i As Long
    Dim t As Single
    Dim tentatives As Integer
    Dim zoomActuel As Integer

    Set ws = ActiveSheet
    
    ' SAUVEGARDE DU ZOOM ET PASSAGE À 100% (Crucial pour la fidélité de CopyPicture)
    zoomActuel = ActiveWindow.Zoom
    ActiveWindow.Zoom = 100
    
    Application.ScreenUpdating = False

    ' On boucle à l'envers car on supprime des éléments
    For i = ws.Comments.Count To 1 Step -1
        Set cmt = ws.Comments(i)
        Set cell = cmt.Parent
        
        With cmt.Shape
            .Visible = msoTrue
            .Line.Visible = msoFalse
            .Shadow.Visible = msoFalse
            
            ' --- NOUVEAU : RÉINITIALISER LE RATIO D'ORIGINE ---
            ' On s'assure que la forme du commentaire est aux bonnes proportions avant copie
            .LockAspectRatio = msoFalse
            ' On ne peut pas utiliser ScaleHeight sur un Comment.Shape facilement, 
            ' mais on peut forcer le "Ajuster à la taille du texte" qui réinitialise souvent le cadre
            .TextFrame.AutoSize = True 
            
            ' On capture l'image
            .CopyPicture Appearance:=xlPrinter, Format:=xlPicture ' xlPrinter est souvent plus précis
        End With

        ' Pause pour le presse-papier
        t = Timer: Do While Timer < t + 0.3: DoEvents: Loop

        ' Boucle de sécurité pour le Paste
        tentatives = 0
        On Error Resume Next
        Do
            Err.Clear
            ws.Paste Destination:=cell
            If Err.Number = 0 Then Exit Do
            tentatives = tentatives + 1
            t = Timer: Do While Timer < t + 0.2: DoEvents: Loop
        Loop While tentatives < 5
        On Error GoTo 0
        
        If tentatives >= 5 Then GoTo SuivantCommentaire

        ' Récupère l'image collée
        Set shp = ws.Shapes(ws.Shapes.Count)

        ' Déterminer l'espace disponible (cellule simple ou fusionnée)
        If cell.MergeCells Then
            cellWidth = cell.MergeArea.Width
            cellHeight = cell.MergeArea.Height
        Else
            cellWidth = cell.Width
            cellHeight = cell.Height
        End If

        ' --- REDIMENSIONNEMENT PROPORTIONNEL (Logique 90%) ---
        ' On utilise le ratio de l'image collée pour ne pas la déformer
        ratioImg = shp.Width / shp.Height

        If (cellWidth / cellHeight) > ratioImg Then
            newHeight = cellHeight * 0.9
            newWidth = newHeight * ratioImg
        Else
            newWidth = cellWidth * 0.9
            newHeight = newWidth / ratioImg
        End If

        With shp
            .LockAspectRatio = msoTrue
            .Width = newWidth
            .Height = newHeight
            .Left = cell.Left + (cellWidth - .Width) / 2
            .Top = cell.Top + (cellHeight - .Height) / 2
            .Placement = xlMoveAndSize
        End With

        cmt.Delete
        
SuivantCommentaire:
    Next i

    ' RÉTABLIR LE ZOOM D'ORIGINE
    ActiveWindow.Zoom = zoomActuel
    Application.ScreenUpdating = True
    MsgBox "Extraction terminée avec respect des proportions !", vbInformation
End Sub
