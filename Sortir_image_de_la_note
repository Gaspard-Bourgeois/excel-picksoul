Sub Sortir_image_de_la_note()
    Dim ws As Worksheet
    Dim cmt As Comment
    Dim shp As Shape
    Dim cell As Range
    Dim ratioNote As Double
    Dim cellWidth As Double, cellHeight As Double
    Dim finalW As Double, finalH As Double
    Dim i As Long
    Dim t As Single
    Dim zoomActuel As Integer

    Set ws = ActiveSheet
    
    ' Fixer le zoom à 100% est indispensable pour la précision de la copie
    zoomActuel = ActiveWindow.Zoom
    ActiveWindow.Zoom = 100
    
    Application.ScreenUpdating = False

    ' Boucle à l'envers pour permettre la suppression des commentaires
    For i = ws.Comments.Count To 1 Step -1
        Set cmt = ws.Comments(i)
        Set cell = cmt.Parent
        
        ' 1. Capturer les proportions exactes de la note
        ratioNote = cmt.Shape.Width / cmt.Shape.Height
        
        ' 2. Préparer et copier
        With cmt.Shape
            .Visible = msoTrue
            .Line.Visible = msoFalse
            .Shadow.Visible = msoFalse
            .CopyPicture Appearance:=xlScreen, Format:=xlPicture
        End With

        ' Petite pause pour le presse-papier
        t = Timer: Do While Timer < t + 0.2: DoEvents: Loop

        ' 3. Coller avec sécurité
        On Error Resume Next
        ws.Paste Destination:=cell
        If Err.Number <> 0 Then
            Err.Clear
            ' Deuxième tentative si échec
            DoEvents
            ws.Paste Destination:=cell
        End If
        On Error GoTo 0

        ' 4. Redimensionner l'image collée
        Set shp = ws.Shapes(ws.Shapes.Count)
        
        ' Dimensions de la zone de destination (cellule ou fusion)
        cellWidth = cell.MergeArea.Width
        cellHeight = cell.MergeArea.Height

        ' Calcul du redimensionnement (90% de la cellule) en gardant le ratio de la note
        If (cellWidth / cellHeight) > ratioNote Then
            finalH = cellHeight * 0.9
            finalW = finalH * ratioNote
        Else
            finalW = cellWidth * 0.9
            finalH = finalW / ratioNote
        End If

        ' Application des propriétés
        With shp
            .LockAspectRatio = msoTrue
            .Width = finalW
            .Height = finalH
            ' Centrage
            .Left = cell.Left + (cell.MergeArea.Width - .Width) / 2
            .Top = cell.Top + (cell.MergeArea.Height - .Height) / 2
            .Placement = xlMoveAndSize
        End With

        ' 5. Nettoyage
        cmt.Delete
    Next i

    ' Rétablir le zoom
    ActiveWindow.Zoom = zoomActuel
    Application.ScreenUpdating = True
    MsgBox "Images extraites avec succès !", vbInformation
End Sub
